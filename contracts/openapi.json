    "/conjunctions/{id}/ephemeris": {
      "get": {
        "tags": [
          "Conjunctions"
        ],
        "summary": "Conjunction Ephemeris",
        "operationId": "conjunction_ephemeris_conjunctions__id__ephemeris_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "seconds_before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1800,
              "minimum": 1,
              "default": 300,
              "title": "Seconds Before"
            }
          },
          {
            "name": "seconds_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1800,
              "minimum": 1,
              "default": 300,
              "title": "Seconds After"
            }
          },
          {
            "name": "step_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 600,
