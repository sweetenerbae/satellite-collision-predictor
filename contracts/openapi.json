                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/satellites/{norad_id}/ephemeris": {
      "get": {
        "tags": [
          "Satellites"
        ],
        "summary": "Satellite Ephemeris",
        "operationId": "satellite_ephemeris_satellites__norad_id__ephemeris_get",
        "parameters": [
          {
            "name": "norad_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Norad Id"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
